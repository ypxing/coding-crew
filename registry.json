{
  "docs": {
    "templates": {
      "issue-tracker": {
        "source": "docs/templates/trackers/local.md",
        "dest": ".coding-crew/docs/issue-tracker.md"
      }
    },
    "scripts": {
      "mark-issue-done": {
        "source": "scripts/tracker/mark-issue-done.sh",
        "dest": ".coding-crew/scripts/mark-issue-done.sh"
      },
      "tracker-config": {
        "source": "scripts/tracker/tracker-config.sh",
        "dest": ".coding-crew/scripts/tracker-config.sh"
      }
    }
  },
  "retired-agents": {
    "names": [
      "crew-coder",
      "crew-reviewer",
      "crew-triage",
      "crew-code-reviewer"
    ],
    "paths": {
      "claude": ".claude/agents/{name}.md",
      "copilot": ".copilot/agents/{name}.agent.md",
      "pi": ".pi/agents/{name}.md",
      "codex": ".codex/agents/{name}.toml"
    },
    "dirs": [
      ".coding-crew/agents",
      ".coding-crew/code-review"
    ]
  },
  "skills": {
    "crew-afk": {
      "version": "2.23.0",
      "source-dir": "crew-afk",
      "description": "Orchestrator that dispatches each ready-for-agent issue to a coder CLI process in its own worktree, reviews and merges every branch, turns the feature review's most severe Actionable findings (at most 8) into one fix issue for a second fix phase, and loops until all ready-for-agent issues are done.",
      "install": ".claude/skills/crew-afk",
      "install-copilot": ".copilot/skills/crew-afk",
      "install-pi": ".pi/skills/crew-afk",
      "install-codex": ".agents/skills/crew-afk",
      "assets": {
        "source": "orchestrator",
        "dest": ".coding-crew/crew-afk"
      },
      "more-assets": [
        {
          "source": "skills/_shared/fragments",
          "dest": ".coding-crew/skills/_shared/fragments"
        }
      ],
      "scripts": [
        "feature-branch-setup.sh",
        "discover-commands.sh",
        "write-commands-cache.sh"
      ],
      "deps": [
        "tdd",
        "dep-install",
        "solve-issue",
        "to-issues",
        "crew-address-findings",
        "write-pr"
      ]
    },
    "tdd": {
      "version": "1.2.1",
      "source-dir": "tdd",
      "description": "Test-driven development with red-green-refactor loop, vertical slices.",
      "source": "mattpocock/skills",
      "install": ".claude/skills/tdd"
    },
    "dep-install": {
      "version": "1.5.2",
      "source-dir": "dep-install",
      "description": "Detect install mode (host or docker) and install project dependencies once. Shared by solve-issue, crew-address-findings, and address-pr-comments.",
      "install": ".claude/skills/dep-install",
      "assets": {
        "source": "skills/dep-install/scripts",
        "dest": ".coding-crew/dep-install/scripts"
      }
    },
    "solve-issue": {
      "version": "1.12.2",
      "source-dir": "solve-issue",
      "description": "Implement a single issue end-to-end: read, explore, install, TDD, verify, commit.",
      "install": ".claude/skills/solve-issue",
      "assets": {
        "source": "skills/solve-issue/scripts",
        "dest": ".coding-crew/solve-issue/scripts"
      },
      "scripts": [
        "commit-changes.sh",
        "write-commands-cache.sh"
      ],
      "deps": [
        "dep-install",
        "tdd"
      ]
    },
    "crew-address-findings": {
      "version": "1.4.4",
      "source-dir": "crew-address-findings",
      "description": "Triage and fix findings from a crew-afk code review report using TDD.",
      "install": ".claude/skills/crew-address-findings",
      "scripts": [
        "branch-safety-check.sh",
        "commit-changes.sh"
      ],
      "deps": [
        "dep-install",
        "tdd"
      ]
    },
    "address-pr-comments": {
      "version": "1.4.0",
      "source-dir": "address-pr-comments",
      "description": "Fetch PR review comments, challenge each critically, implement sensible ones with TDD, commit and push.",
      "install": ".claude/skills/address-pr-comments",
      "scripts": [
        "branch-safety-check.sh",
        "commit-changes.sh"
      ],
      "deps": [
        "dep-install",
        "solve-issue",
        "tdd"
      ]
    },
    "to-issues": {
      "version": "1.12.1",
      "source-dir": "to-issues",
      "description": "Break a plan or PRD into independently-grabbable issues using tracer-bullet vertical slices.",
      "source": "mattpocock/skills",
      "install": ".claude/skills/to-issues",
      "assets": {
        "source": "skills/to-issues/scripts",
        "dest": ".coding-crew/to-issues/scripts"
      }
    },
    "to-prd": {
      "version": "1.4.4",
      "source-dir": "to-prd",
      "description": "Synthesize conversation context into a PRD and publish to the issue tracker.",
      "source": "mattpocock/skills",
      "install": ".claude/skills/to-prd"
    },
    "crew-brainstorm": {
      "version": "1.2.1",
      "source-dir": "crew-brainstorm",
      "description": "Collaborative design pipeline: explore intent, propose approaches, build a spec, then hand off to PRD and issues.",
      "install": ".claude/skills/crew-brainstorm",
      "install-copilot": ".copilot/skills/crew-brainstorm",
      "install-pi": ".pi/skills/crew-brainstorm",
      "install-codex": ".agents/skills/crew-brainstorm",
      "deps": [
        "to-prd",
        "to-issues"
      ]
    },
    "crew-grill": {
      "version": "1.3.1",
      "source-dir": "crew-grill",
      "description": "Adversarial design pipeline: stress-test every assumption, capture decisions, then produce a PRD and issues.",
      "install": ".claude/skills/crew-grill",
      "install-copilot": ".copilot/skills/crew-grill",
      "install-pi": ".pi/skills/crew-grill",
      "install-codex": ".agents/skills/crew-grill",
      "deps": [
        "domain-modeling",
        "to-prd",
        "to-issues"
      ]
    },
    "add-tests": {
      "version": "1.1.6",
      "source-dir": "add-tests",
      "description": "Discover the project's coverage command, rank under-covered files by risk, resolve a mocking convention per ecosystem, and hand findings to to-issues as ready-for-agent issues.",
      "install": ".claude/skills/add-tests",
      "install-copilot": ".copilot/skills/add-tests",
      "install-pi": ".pi/skills/add-tests",
      "install-codex": ".agents/skills/add-tests",
      "scripts": [
        "discover-commands.sh",
        "write-commands-cache.sh"
      ],
      "deps": [
        "to-issues",
        "dep-install"
      ]
    },
    "upgrade-deps": {
      "version": "1.1.4",
      "source-dir": "upgrade-deps",
      "description": "Audit outdated npm/yarn/pnpm dependencies for exploitability, transitive conflicts, and usage, then publish issues (batched safe bumps, one per risky package or coupled group) with a safety checklist.",
      "install": ".claude/skills/upgrade-deps",
      "deps": [
        "dep-install"
      ]
    },
    "configure-tracker": {
      "version": "1.3.3",
      "source-dir": "configure-tracker",
      "description": "Select and install an issue tracker template. Presents a numbered menu of templates from docs/templates/trackers/, then writes the chosen template to the project-level config path.",
      "install": ".claude/skills/configure-tracker",
      "scripts": [
        "configure-tracker-auto.sh"
      ]
    },
    "domain-modeling": {
      "version": "1.0.0",
      "source-dir": "domain-modeling",
      "description": "Updates CONTEXT.md glossary and creates ADRs inline as design decisions crystallise.",
      "install": ".claude/skills/domain-modeling"
    },
    "write-pr": {
      "version": "1.1.0",
      "source-dir": "write-pr",
      "description": "Write a short PR body for a human reviewer: Why, What changes, Risk and Tested.",
      "source": "mattpocock/skills",
      "install": ".claude/skills/write-pr",
      "assets": {
        "source": "skills/write-pr",
        "dest": ".coding-crew/write-pr"
      }
    }
  }
}
