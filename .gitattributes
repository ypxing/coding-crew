# Shell scripts, test files, and the markdown/JSON they read keep LF endings, whatever a
# checkout's core.autocrlf: bash fails on `$'\r'`.
* text=auto eol=lf

*.sh text eol=lf
*.bats text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.js text eol=lf

# Every PR adds its entry at the top of [Unreleased], so any two branches conflict there; union keeps both
# (ours first). solve-feature's start merges the default branch into a resumed branch and stops on a conflict.
CHANGELOG.md merge=union
