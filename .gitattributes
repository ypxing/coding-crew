# Shell scripts, test files, and the markdown/JSON they read must keep LF endings.
# GitHub's windows-latest runners set core.autocrlf=true, so without this checkout
# rewrites these files with CRLF: bash then fails on `$'\r'` and bats output
# assertions miss on trailing \r.
* text=auto eol=lf

*.sh text eol=lf
*.bats text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.js text eol=lf

# Every PR adds its entry at the top of [Unreleased], so any two branches conflict there; union keeps both
# (ours first). solve-feature's start merges the default branch into a resumed branch and stops on a conflict.
CHANGELOG.md merge=union

# Copies of lib/<lib>/ that scripts/render-skill.sh writes: collapsed in PR diffs, edited only through lib/.
skills/*/scripts/checks/** linguist-generated=true
skills/*/scripts/tracker/** linguist-generated=true
skills/*/scripts/git-workflow/** linguist-generated=true
